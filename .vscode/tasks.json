{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PHP Server",
      "type": "shell",
      "command": "php",
      "args": [
        "-d",
        "extension=pdo_sqlite",
        "-d",
        "extension=sqlite3",
        "-S",
        "127.0.0.1:8000",
        "-t",
        "${workspaceFolder}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          { "regexp": ".", "file": 1, "location": 2, "message": 3 }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Listening on"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
